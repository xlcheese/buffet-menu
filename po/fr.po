#: buffet_menu.py:124
msgid "Buffet Menu's own module, for the header bar: run ./build.sh in Buffet Menu's folder (it needs build-essential and libgtk-3-dev)"
msgstr "Le module de Buffet Menu, pour la barre de titre : lancez ./build.sh dans le dossier de Buffet Menu (il faut build-essential et libgtk-3-dev)"

#: buffet_menu.py:127
msgid "appmenu-gtk3-module (to read the applications' menus)"
msgstr "appmenu-gtk3-module (pour lire les menus des applications)"

#: buffet_menu.py:129
msgid "gir1.2-keybinder-3.0 (for the keyboard shortcut)"
msgstr "gir1.2-keybinder-3.0 (pour le raccourci clavier)"

#: buffet_menu.py:495
msgid "This window doesn't have the Buffet menu"
msgstr "Cette fenêtre n'a pas le menu Buffet"

#: buffet_menu.py:496
msgid "Add its application in Buffet Menu's settings, then close and reopen it."
msgstr "Ajoutez son application dans les paramètres de Buffet Menu, puis fermez-la et rouvrez-la."

#: buffet_menu.py:504
#, python-brace-format
msgid "{application} has no menu bar"
msgstr "{application} n'a pas de barre de menus"

#: buffet_menu.py:505
msgid "Its menus can't be shown as a Buffet menu."
msgstr "Ses menus ne peuvent pas être affichés en menu Buffet."

#: buffet_menu.py:594
msgid "It has a header bar of its own."
msgstr "Elle a sa propre barre de titre."

#: buffet_menu.py:594
msgid "It has no menu bar."
msgstr "Elle n'a pas de barre de menus."

#: buffet_menu.py:595
#, python-brace-format
msgid "{application} can't have the Buffet menu"
msgstr "{application} ne peut pas avoir le menu Buffet"

#: buffet_menu.py:596
msgid "It was taken off Buffet Menu's list, and will be as before when you reopen it."
msgstr "Elle a été retirée de la liste de Buffet Menu, et sera comme avant quand vous la rouvrirez."

#: buffet_menu.py:705
#, python-brace-format
msgid "Settings of the Buffet menu of {application}"
msgstr "Paramètres du menu Buffet de {application}"

#: buffet_menu.py:717 buffet_menu.py:720
msgid "Buffet Menu"
msgstr "Buffet Menu"

#: buffet_menu.py:720
msgid "Every menu of your applications at once"
msgstr "Tous les menus de vos applications d'un coup"

#: buffet_menu.py:730
msgid "Buffet Menu needs some packages that aren't installed:"
msgstr "Buffet Menu a besoin de paquets qui ne sont pas installés :"

#: buffet_menu.py:732
msgid "Install them with:"
msgstr "Installez-les avec :"

#: buffet_menu.py:742
msgid "Applications"
msgstr "Applications"

#: buffet_menu.py:743
msgid "Search"
msgstr "Rechercher"

#: buffet_menu.py:750
msgid "Show all applications"
msgstr "Afficher toutes les applications"

#: buffet_menu.py:751
msgid "Also those that can't have the Buffet menu, as far as Buffet Menu can tell: GTK 2, GTK 4 or Qt ones, for example"
msgstr "Aussi celles qui ne peuvent pas avoir le menu Buffet, autant que Buffet Menu puisse le savoir : celles en GTK 2, GTK 4 ou Qt, par exemple"

#: buffet_menu.py:759
msgid "Give the Buffet menu to this application"
msgstr "Donner le menu Buffet à cette application"

#: buffet_menu.py:761
msgid "Take the Buffet menu away from this application"
msgstr "Retirer le menu Buffet de cette application"

#: buffet_menu.py:771
msgid "With the Buffet menu"
msgstr "Avec le menu Buffet"

#: buffet_menu.py:774
msgid "Close and reopen an application after adding or removing it."
msgstr "Fermez et rouvrez une application après l'avoir ajoutée ou retirée."

#: buffet_menu.py:789
msgid "Keyboard shortcut"
msgstr "Raccourci clavier"

#: buffet_menu.py:789
msgid "Shows the Buffet menu of the active window"
msgstr "Affiche le menu Buffet de la fenêtre active"

#: buffet_menu.py:790
msgid "Start at login"
msgstr "Lancer à l'ouverture de session"

#: buffet_menu.py:790
msgid "Without it, the menu bars come back until Buffet Menu is started"
msgstr "Sans cela, les barres de menus reviennent jusqu'au lancement de Buffet Menu"

#: buffet_menu.py:846
msgid "Has a header bar of its own"
msgstr "A sa propre barre de titre"

#: buffet_menu.py:848
msgid "Has no menu bar"
msgstr "N'a pas de barre de menus"

#: buffet_menu.py:850
msgid "A GTK 4 application"
msgstr "Une application GTK 4"

#: buffet_menu.py:850
msgid "A GTK 2 application"
msgstr "Une application GTK 2"

#: buffet_menu.py:851
msgid "A Qt application"
msgstr "Une application Qt"

#: buffet_menu.py:851
msgid "Runs as the administrator"
msgstr "S'exécute en tant qu'administrateur"

#: buffet_menu.py:852
msgid "Not a GTK 3 application"
msgstr "Pas une application GTK 3"

#: buffet_menu.py:857
msgid "No menu bar found: this application can't have the Buffet menu"
msgstr "Aucune barre de menus trouvée : cette application ne peut pas avoir le menu Buffet"

#: buffet_menu.py:859
#, python-brace-format
msgid "{count} menu"
msgid_plural "{count} menus"
msgstr[0] "{count} menu"
msgstr[1] "{count} menus"

#: buffet_menu.py:861
msgid "Not opened yet: reopen it, then click its Buffet button"
msgstr "Pas encore ouverte : rouvrez-la, puis cliquez sur son bouton Buffet"

#: buffet_menu.py:863
#, python-brace-format
msgid "Not opened yet: reopen it, then press {shortcut} in it"
msgstr "Pas encore ouverte : rouvrez-la, puis appuyez sur {shortcut} dedans"

#: buffet_menu.py:887
#, python-brace-format
msgid "Buffet menu of {application}"
msgstr "Menu Buffet de {application}"

#: buffet_menu.py:902
msgid "None"
msgstr "Aucun"

#: buffet_menu.py:906
msgid "Press the keys… (Esc to cancel)"
msgstr "Appuyez sur les touches… (Échap pour annuler)"

#: buffet_menu.py:923
msgid "That shortcut is taken"
msgstr "Ce raccourci est déjà utilisé"

#: buffet_menu.py:923
msgid "Choose another one for Buffet Menu."
msgstr "Choisissez-en un autre pour Buffet Menu."

#: buffet.py:244
#, python-brace-format
msgid "Shortcut: {shortcut}"
msgstr "Raccourci : {shortcut}"

#: buffet.py:388
msgid "Close the menu"
msgstr "Fermer le menu"

#: buffet.py:996
msgid "Preferences"
msgstr "Préférences"

#: buffet.py:999
msgid "_Close"
msgstr "Fer_mer"

#: buffet.py:1015
msgid "menus per row"
msgstr "menus par ligne"

#: buffet.py:1016
msgid "Menu layout"
msgstr "Disposition des menus"

#: buffet.py:1017
msgid "One row, then _equal rows"
msgstr "Une ligne, puis des lignes _égales"

#: buffet.py:1018
msgid "If one row doesn't fit, as few rows as fit, with as many menus in each"
msgstr "Si une ligne ne suffit pas, le moins de lignes possible, avec autant de menus dans chacune"

#: buffet.py:1019
msgid "One row, then fi_ll each row"
msgstr "Une ligne, puis _remplir chaque ligne"

#: buffet.py:1020
msgid "If one row doesn't fit, as many menus in each row as fit"
msgstr "Si une ligne ne suffit pas, autant de menus que possible dans chaque ligne"

#: buffet.py:1021
msgid "T_wo rows"
msgstr "_Deux lignes"

#: buffet.py:1021
msgid "More rows only if two don't fit"
msgstr "Plus de lignes seulement si deux ne suffisent pas"

#: buffet.py:1022
msgid "_Fixed:"
msgstr "_Fixe :"

#: buffet.py:1022
msgid "Always the same number of menus in each row"
msgstr "Toujours le même nombre de menus par ligne"

#: buffet.py:1024
msgid "Row width"
msgstr "Largeur des lignes"

#: buffet.py:1025
msgid "The application's win_dow"
msgstr "La fe_nêtre de l'application"

#: buffet.py:1026
msgid "The menu stays inside the window when it can"
msgstr "Le menu reste dans la fenêtre quand c'est possible"

#: buffet.py:1027
msgid "The scree_n"
msgstr "L'écr_an"

#: buffet.py:1027
msgid "Wider rows, so fewer of them"
msgstr "Des lignes plus larges, donc moins nombreuses"

#: buffet.py:1029
msgid "When there's no room below the title bar"
msgstr "Quand il n'y a pas de place sous la barre de titre"

#: buffet.py:1030
msgid "Move the _menu up"
msgstr "Monter le men_u"

#: buffet.py:1030
msgid "Above the title bar, or over it,\nwith the rows as they are"
msgstr "Au-dessus de la barre de titre, ou par-dessus,\navec les lignes telles quelles"

#: buffet.py:1031
msgid "Change the _rows to fit"
msgstr "Changer les _lignes pour tenir"

#: buffet.py:1031
msgid "Below the title bar,\nwith fewer, wider rows"
msgstr "Sous la barre de titre,\navec moins de lignes, plus larges"

#: buffet.py:1033
msgid "Rows"
msgstr "Lignes"

#: buffet.py:1034
msgid "Lined _up"
msgstr "Al_ignées"

#: buffet.py:1034
msgid "Each row starts at the same height,\nwith a line between rows"
msgstr "Chaque ligne commence à la même hauteur,\navec un trait entre les lignes"

#: buffet.py:1035
msgid "Stac_ked up"
msgstr "Em_pilées"

#: buffet.py:1035
msgid "Each menu right under the one above it:\nshorter, but busier"
msgstr "Chaque menu juste sous celui du dessus :\nplus court, mais plus chargé"

#: buffet.py:1037
msgid "Keyboard shortcuts"
msgstr "Raccourcis clavier"

#: buffet.py:1038
msgid "_Show next to each item"
msgstr "Affic_her à côté de chaque élément"

#: buffet.py:1038
msgid "As in other menus"
msgstr "Comme dans les autres menus"

#: buffet.py:1039
msgid "Show in a _tooltip"
msgstr "Afficher dans une info-_bulle"

#: buffet.py:1040
msgid "Narrower menus: point at an item to see its shortcut"
msgstr "Menus plus étroits : pointez un élément pour voir son raccourci"

#: buffet.py:1041
msgid "_Hide"
msgstr "Mas_quer"

#: buffet.py:1041
msgid "The narrowest menus"
msgstr "Les menus les plus étroits"

#: buffet.py:1058
msgid "Chosen the first time this menu opens, from how many menus there are"
msgstr "Choisi à la première ouverture de ce menu, selon le nombre de menus"

#: buffet-headerbar.c:441
msgid "Menu"
msgstr "Menu"
