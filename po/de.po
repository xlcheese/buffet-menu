#: buffet_menu.py:124
msgid "Buffet Menu's own module, for the header bar: run ./build.sh in Buffet Menu's folder (it needs build-essential and libgtk-3-dev)"
msgstr "Das eigene Modul von Buffet Menu, für die Kopfleiste: Führen Sie ./build.sh im Ordner von Buffet Menu aus (benötigt build-essential und libgtk-3-dev)"

#: buffet_menu.py:127
msgid "appmenu-gtk3-module (to read the applications' menus)"
msgstr "appmenu-gtk3-module (um die Menüs der Anwendungen zu lesen)"

#: buffet_menu.py:129
msgid "gir1.2-keybinder-3.0 (for the keyboard shortcut)"
msgstr "gir1.2-keybinder-3.0 (für das Tastenkürzel)"

#: buffet_menu.py:495
msgid "This window doesn't have the Buffet menu"
msgstr "Dieses Fenster hat kein Buffet-Menü"

#: buffet_menu.py:496
msgid "Add its application in Buffet Menu's settings, then close and reopen it."
msgstr "Fügen Sie seine Anwendung in den Einstellungen von Buffet Menu hinzu, dann schließen und öffnen Sie sie erneut."

#: buffet_menu.py:504
#, python-brace-format
msgid "{application} has no menu bar"
msgstr "{application} hat keine Menüleiste"

#: buffet_menu.py:505
msgid "Its menus can't be shown as a Buffet menu."
msgstr "Ihre Menüs können nicht als Buffet-Menü angezeigt werden."

#: buffet_menu.py:594
msgid "It has a header bar of its own."
msgstr "Sie hat eine eigene Kopfleiste."

#: buffet_menu.py:594
msgid "It has no menu bar."
msgstr "Sie hat keine Menüleiste."

#: buffet_menu.py:595
#, python-brace-format
msgid "{application} can't have the Buffet menu"
msgstr "{application} kann kein Buffet-Menü haben"

#: buffet_menu.py:596
msgid "It was taken off Buffet Menu's list, and will be as before when you reopen it."
msgstr "Sie wurde aus der Liste von Buffet Menu entfernt und ist beim nächsten Öffnen wieder wie zuvor."

#: buffet_menu.py:705
#, python-brace-format
msgid "Settings of the Buffet menu of {application}"
msgstr "Einstellungen des Buffet-Menüs von {application}"

#: buffet_menu.py:717 buffet_menu.py:720
msgid "Buffet Menu"
msgstr "Buffet Menu"

#: buffet_menu.py:720
msgid "Every menu of your applications at once"
msgstr "Alle Menüs Ihrer Anwendungen auf einmal"

#: buffet_menu.py:730
msgid "Buffet Menu needs some packages that aren't installed:"
msgstr "Buffet Menu benötigt einige Pakete, die nicht installiert sind:"

#: buffet_menu.py:732
msgid "Install them with:"
msgstr "Installieren Sie sie mit:"

#: buffet_menu.py:742
msgid "Applications"
msgstr "Anwendungen"

#: buffet_menu.py:743
msgid "Search"
msgstr "Suchen"

#: buffet_menu.py:750
msgid "Show all applications"
msgstr "Alle Anwendungen anzeigen"

#: buffet_menu.py:751
msgid "Also those that can't have the Buffet menu, as far as Buffet Menu can tell: GTK 2, GTK 4 or Qt ones, for example"
msgstr "Auch solche, die kein Buffet-Menü haben können, soweit Buffet Menu das erkennen kann: zum Beispiel GTK-2-, GTK-4- oder Qt-Anwendungen"

#: buffet_menu.py:759
msgid "Give the Buffet menu to this application"
msgstr "Dieser Anwendung das Buffet-Menü geben"

#: buffet_menu.py:761
msgid "Take the Buffet menu away from this application"
msgstr "Dieser Anwendung das Buffet-Menü wegnehmen"

#: buffet_menu.py:771
msgid "With the Buffet menu"
msgstr "Mit Buffet-Menü"

#: buffet_menu.py:774
msgid "Close and reopen an application after adding or removing it."
msgstr "Schließen und öffnen Sie eine Anwendung erneut, nachdem Sie sie hinzugefügt oder entfernt haben."

#: buffet_menu.py:789
msgid "Keyboard shortcut"
msgstr "Tastenkürzel"

#: buffet_menu.py:789
msgid "Shows the Buffet menu of the active window"
msgstr "Zeigt das Buffet-Menü des aktiven Fensters"

#: buffet_menu.py:790
msgid "Start at login"
msgstr "Bei der Anmeldung starten"

#: buffet_menu.py:790
msgid "Without it, the menu bars come back until Buffet Menu is started"
msgstr "Ohne dies kommen die Menüleisten zurück, bis Buffet Menu gestartet wird"

#: buffet_menu.py:846
msgid "Has a header bar of its own"
msgstr "Hat eine eigene Kopfleiste"

#: buffet_menu.py:848
msgid "Has no menu bar"
msgstr "Hat keine Menüleiste"

#: buffet_menu.py:850
msgid "A GTK 4 application"
msgstr "Eine GTK-4-Anwendung"

#: buffet_menu.py:850
msgid "A GTK 2 application"
msgstr "Eine GTK-2-Anwendung"

#: buffet_menu.py:851
msgid "A Qt application"
msgstr "Eine Qt-Anwendung"

#: buffet_menu.py:851
msgid "Runs as the administrator"
msgstr "Läuft als Administrator"

#: buffet_menu.py:852
msgid "Not a GTK 3 application"
msgstr "Keine GTK-3-Anwendung"

#: buffet_menu.py:857
msgid "No menu bar found: this application can't have the Buffet menu"
msgstr "Keine Menüleiste gefunden: Diese Anwendung kann kein Buffet-Menü haben"

#: buffet_menu.py:859
#, python-brace-format
msgid "{count} menu"
msgid_plural "{count} menus"
msgstr[0] "{count} Menü"
msgstr[1] "{count} Menüs"

#: buffet_menu.py:861
msgid "Not opened yet: reopen it, then click its Buffet button"
msgstr "Noch nicht geöffnet: Öffnen Sie sie erneut und klicken Sie auf ihren Buffet-Knopf"

#: buffet_menu.py:863
#, python-brace-format
msgid "Not opened yet: reopen it, then press {shortcut} in it"
msgstr "Noch nicht geöffnet: Öffnen Sie sie erneut und drücken Sie darin {shortcut}"

#: buffet_menu.py:887
#, python-brace-format
msgid "Buffet menu of {application}"
msgstr "Buffet-Menü von {application}"

#: buffet_menu.py:902
msgid "None"
msgstr "Keines"

#: buffet_menu.py:906
msgid "Press the keys… (Esc to cancel)"
msgstr "Tasten drücken … (Esc zum Abbrechen)"

#: buffet_menu.py:923
msgid "That shortcut is taken"
msgstr "Dieses Tastenkürzel ist bereits vergeben"

#: buffet_menu.py:923
msgid "Choose another one for Buffet Menu."
msgstr "Wählen Sie ein anderes für Buffet Menu."

#: buffet.py:244
#, python-brace-format
msgid "Shortcut: {shortcut}"
msgstr "Tastenkürzel: {shortcut}"

#: buffet.py:388
msgid "Close the menu"
msgstr "Menü schließen"

#: buffet.py:996
msgid "Preferences"
msgstr "Einstellungen"

#: buffet.py:999
msgid "_Close"
msgstr "_Schließen"

#: buffet.py:1015
msgid "menus per row"
msgstr "Menüs pro Reihe"

#: buffet.py:1016
msgid "Menu layout"
msgstr "Anordnung der Menüs"

#: buffet.py:1017
msgid "One row, then _equal rows"
msgstr "Eine Reihe, dann _gleiche Reihen"

#: buffet.py:1018
msgid "If one row doesn't fit, as few rows as fit, with as many menus in each"
msgstr "Wenn eine Reihe nicht passt, so wenige Reihen wie möglich, mit gleich vielen Menüs"

#: buffet.py:1019
msgid "One row, then fi_ll each row"
msgstr "Eine Reihe, dann jede Reihe _füllen"

#: buffet.py:1020
msgid "If one row doesn't fit, as many menus in each row as fit"
msgstr "Wenn eine Reihe nicht passt, so viele Menüs pro Reihe wie hineinpassen"

#: buffet.py:1021
msgid "T_wo rows"
msgstr "_Zwei Reihen"

#: buffet.py:1021
msgid "More rows only if two don't fit"
msgstr "Mehr Reihen nur, wenn zwei nicht passen"

#: buffet.py:1022
msgid "_Fixed:"
msgstr "F_est:"

#: buffet.py:1022
msgid "Always the same number of menus in each row"
msgstr "Immer gleich viele Menüs pro Reihe"

#: buffet.py:1024
msgid "Row width"
msgstr "Breite der Reihen"

#: buffet.py:1025
msgid "The application's win_dow"
msgstr "Das _Anwendungsfenster"

#: buffet.py:1026
msgid "The menu stays inside the window when it can"
msgstr "Das Menü bleibt im Fenster, wenn es geht"

#: buffet.py:1027
msgid "The scree_n"
msgstr "Der _Bildschirm"

#: buffet.py:1027
msgid "Wider rows, so fewer of them"
msgstr "Breitere Reihen, also weniger davon"

#: buffet.py:1029
msgid "When there's no room below the title bar"
msgstr "Wenn unter der Titelleiste kein Platz ist"

#: buffet.py:1030
msgid "Move the _menu up"
msgstr "Menü nach _oben verschieben"

#: buffet.py:1030
msgid "Above the title bar, or over it,\nwith the rows as they are"
msgstr "Über der Titelleiste oder darüber gelegt,\nmit den Reihen, wie sie sind"

#: buffet.py:1031
msgid "Change the _rows to fit"
msgstr "_Reihen passend ändern"

#: buffet.py:1031
msgid "Below the title bar,\nwith fewer, wider rows"
msgstr "Unter der Titelleiste,\nmit weniger, breiteren Reihen"

#: buffet.py:1033
msgid "Rows"
msgstr "Reihen"

#: buffet.py:1034
msgid "Lined _up"
msgstr "Ausgerich_tet"

#: buffet.py:1034
msgid "Each row starts at the same height,\nwith a line between rows"
msgstr "Jede Reihe beginnt auf gleicher Höhe,\nmit einer Linie zwischen den Reihen"

#: buffet.py:1035
msgid "Stac_ked up"
msgstr "Gesta_pelt"

#: buffet.py:1035
msgid "Each menu right under the one above it:\nshorter, but busier"
msgstr "Jedes Menü direkt unter dem darüber:\nkürzer, aber unruhiger"

#: buffet.py:1037
msgid "Keyboard shortcuts"
msgstr "Tastenkürzel"

#: buffet.py:1038
msgid "_Show next to each item"
msgstr "_Neben jedem Eintrag zeigen"

#: buffet.py:1038
msgid "As in other menus"
msgstr "Wie in anderen Menüs"

#: buffet.py:1039
msgid "Show in a _tooltip"
msgstr "In einer Mini_hilfe zeigen"

#: buffet.py:1040
msgid "Narrower menus: point at an item to see its shortcut"
msgstr "Schmalere Menüs: Tastenkürzel beim Zeigen auf einen Eintrag"

#: buffet.py:1041
msgid "_Hide"
msgstr "_Verbergen"

#: buffet.py:1041
msgid "The narrowest menus"
msgstr "Die schmalsten Menüs"

#: buffet.py:1058
msgid "Chosen the first time this menu opens, from how many menus there are"
msgstr "Wird beim ersten Öffnen dieses Menüs gewählt, je nachdem, wie viele Menüs es gibt"

#: buffet-headerbar.c:441
msgid "Menu"
msgstr "Menü"
